---
import { site } from '../data/site.js';
import { withBase } from '../utils/paths.js';
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Ready to get started?',
  body = 'Reach out for a free, no-pressure quote on your next drywall or painting project.',
} = Astro.props;
---

<section class="cta">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{body}</p>
    </div>
    <div class="cta-actions">
      <a href={withBase('/contact')} class="btn btn-primary">Get a Free Quote</a>
      <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`} class="btn btn-secondary">
        Call {site.phone}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-navy);
    background-image: linear-gradient(135deg, var(--color-navy) 0%, var(--color-navy-light) 100%);
    color: #fff;
    padding: 3.5rem 0;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta h2 {
    color: #fff;
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    margin-bottom: 0.4rem;
  }

  .cta p {
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    max-width: 46ch;
  }

  .cta-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
</style>

---
import { site } from '../data/site.js';
import { withBase } from '../utils/paths.js';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img
        src={withBase('/images/brand/logo-mark.png')}
        alt={`${site.name} logo`}
        class="footer-logo"
        width="720"
        height="758"
        loading="lazy"
      />
      <span class="brand-name">{site.name}</span>
      <p>{site.subTagline}</p>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
    </div>

    <div class="footer-col">
      <h4>Service Area</h4>
      <p>{site.serviceArea}</p>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href={withBase('/services')}>Services</a>
      <a href={withBase('/projects')}>Projects</a>
      <a href={withBase('/contact')}>Get a Free Quote</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      &copy; {year} {site.name}. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.85);
    margin-top: 4rem;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding: 3.5rem 1.5rem;
  }

  .footer-logo {
    width: 84px;
    height: auto;
    border-radius: 10px;
    margin-bottom: 1rem;
  }

  .footer-brand .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.2rem;
    color: #fff;
  }

  .footer-brand p {
    color: rgba(255, 255, 255, 0.65);
    margin-top: 0.5rem;
    max-width: 26ch;
  }

  .footer-col h4 {
    color: #fff;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.9rem;
  }

  .footer-col a,
  .footer-col p {
    display: block;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.55rem;
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.2rem 0;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
  }

  @media (max-width: 760px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 500px) {
    .footer-inner {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { site } from '../data/site.js';
import { withBase } from '../utils/paths.js';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

// Strip the base path so nav-item hrefs ('/', '/services', ...) can be
// compared directly against the current route regardless of deployment base.
const rawBase = import.meta.env.BASE_URL;
const baseNoSlash = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const strippedPath = baseNoSlash && Astro.url.pathname.startsWith(baseNoSlash)
  ? Astro.url.pathname.slice(baseNoSlash.length) || '/'
  : Astro.url.pathname;
const currentPath = strippedPath.length > 1 ? strippedPath.replace(/\/$/, '') : '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href={withBase('/')} class="brand">
      <span class="brand-mark">IW</span>
      <span class="brand-text">
        <span class="brand-name">{site.shortName}</span>
        <span class="brand-sub">Drywall &amp; Painting</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['nav-link', { active: currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`} class="btn btn-primary header-cta">
      Call {site.phone}
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
    <label for="nav-toggle" class="nav-toggle" aria-label="Toggle menu">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="nav-mobile" aria-label="Mobile">
      {navItems.map((item) => (
        <a href={withBase(item.href)} class:list={['nav-link', { active: currentPath === item.href }]}>
          {item.label}
        </a>
      ))}
      <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`} class="btn btn-primary">
        Call {site.phone}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(238, 240, 241, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-right: auto;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: var(--color-navy);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 1.05rem;
  }

  .brand-sub {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }

  .nav-desktop {
    display: flex;
    gap: 1.75rem;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-text);
    padding: 0.4rem 0;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-accent-dark);
  }

  .nav-link.active {
    color: var(--color-accent-dark);
    border-bottom-color: var(--color-accent);
  }

  .header-cta {
    white-space: nowrap;
    padding: 0.65rem 1.3rem;
    font-size: 0.88rem;
  }

  .nav-toggle-input {
    display: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 0.4rem;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--color-navy);
    display: block;
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-desktop,
    .header-cta {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-mobile {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: 1rem 1.5rem 1.5rem;
      gap: 0.9rem;
      display: none;
    }

    .nav-toggle-input:checked ~ .nav-mobile {
      display: flex;
    }

    .nav-mobile .btn {
      align-self: flex-start;
      margin-top: 0.5rem;
    }
  }
</style>

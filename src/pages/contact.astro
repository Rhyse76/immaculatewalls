---
import Layout from '../layouts/Layout.astro';
import CalBooking from '../components/CalBooking.astro';
import { site, hours } from '../data/site.js';

const FORMSPREE_ID = 'xeeyvkgv';
---

<Layout title="Contact" description="Get a free quote from Immaculate Drywall and Construction — call, email, or send a message.">
  <section class="section page-hero">
    <div class="container">
      <span class="eyebrow">Get In Touch</span>
      <h1>Get a Free Quote</h1>
      <p class="page-lede">
        Tell us about your project and we'll get back to you. Prefer to talk
        it through? Give us a call.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Book Online</span>
        <h2>Schedule a Free Estimate</h2>
        <p>Pick a time that works for you &mdash; no phone tag required.</p>
      </div>
      <CalBooking calLink="immaculatewalls/30min" namespace="30min" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Or Reach Out Directly</span>
        <h2>Prefer to call or message?</h2>
      </div>
      <div class="contact-grid">
      <div class="contact-info">
        <div class="info-card card">
          <h3>Phone</h3>
          <a href={`tel:${site.phone.replace(/[^0-9]/g, '')}`} class="info-value">{site.phone}</a>
        </div>
        <div class="info-card card">
          <h3>Email</h3>
          <a href={`mailto:${site.email}`} class="info-value">{site.email}</a>
        </div>
        <div class="info-card card">
          <h3>Service Area</h3>
          <p class="info-value">{site.serviceArea}</p>
        </div>
        <div class="info-card card">
          <h3>Hours</h3>
          {hours.map((h) => (
            <p class="hours-row">
              <span class="hours-days">{h.days}</span>
              <span class="hours-time">{h.time}</span>
            </p>
          ))}
        </div>
        <div class="info-card card">
          <h3>Facebook</h3>
          <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="info-value">
            See more photos &amp; reviews
          </a>
        </div>
      </div>

      <form class="contact-form card" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
        <h3>Send a Message</h3>

        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />

        <label for="phone">Phone</label>
        <input type="tel" id="phone" name="phone" required />

        <label for="email">Email</label>
        <input type="email" id="email" name="email" />

        <label for="service">What do you need done?</label>
        <select id="service" name="service">
          <option value="">Select a service</option>
          <option>Drywall Hanging &amp; Finishing</option>
          <option>Drywall Repair</option>
          <option>Framing</option>
          <option>Painting</option>
          <option>Textures &amp; Knockdown</option>
          <option>Drop Ceilings</option>
          <option>Baseboards &amp; Trim</option>
          <option>Flooring</option>
          <option>New Construction</option>
          <option>Other / Not Sure</option>
        </select>

        <label for="message">Project Details</label>
        <textarea id="message" name="message" rows="5" required></textarea>

        <button type="submit" class="btn btn-primary">Send Message</button>
      </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-bottom: 1rem;
  }
  .page-lede {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 60ch;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2rem;
    align-items: start;
  }

  .contact-info {
    display: grid;
    gap: 1.25rem;
  }

  .info-card {
    padding: 1.5rem;
  }

  .info-card h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.4rem;
  }

  .info-value {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-navy);
  }

  .hours-row {
    margin: 0 0 0.75rem;
  }

  .hours-row:last-child {
    margin-bottom: 0;
  }

  .hours-days,
  .hours-time {
    display: block;
    font-family: var(--font-heading);
  }

  .hours-days {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-navy);
  }

  .hours-time {
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .contact-form {
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .contact-form h3 {
    margin-bottom: 1.25rem;
  }

  .contact-form label {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.88rem;
    margin-bottom: 0.35rem;
    margin-top: 1rem;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 0.98rem;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .contact-form button {
    margin-top: 1.5rem;
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
